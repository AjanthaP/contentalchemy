# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# SERP API (for research)
SERP_API_KEY=your_serp_api_key_here

# Optional: Alternative Services
PERPLEXITY_API_KEY=your_perplexity_key
ANTHROPIC_API_KEY=your_claude_key

# Application Settings
APP_NAME=ContentAlchemy
DEBUG=True
LOG_LEVEL=INFO
MAX_TOKENS=4000
TEMPERATURE=0.7

# Image Generation
DALLE_MODEL=gpt-image-2.5-flare
DALLE_SIZE=1024x1024
DALLE_QUALITY=standard

# Content Settings
MAX_RESEARCH_RESULTS=10
BLOG_MIN_WORDS=1000
BLOG_MAX_WORDS=2000

# Redis (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS=false

# Stable Diffusion via Hugging Face (Optional - alternative image provider)
HF_API_KEY=your_hugging_face_token

# LangSmith tracing (Optional)
LANGSMITH_API_KEY=your_langsmith_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=contentalchemy

# LinkedIn OAuth (Optional - for "Post to LinkedIn")
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/linkedin/callback
FRONTEND_BASE_URL=http://localhost:5173

# CORS - comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (per client IP unless noted)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_GENERATE=5/minute;50/day
RATE_LIMIT_GENERATE_GLOBAL=500/day
RATE_LIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_HOPS=1
